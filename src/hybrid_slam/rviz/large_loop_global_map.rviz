Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
      Cell Size: 50
      Plane Cell Count: 40
      Color: 100; 100; 100
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Optimized Global Map
      Style: Points
      Size (m): 0.08
      Alpha: 1
      Color Transformer: FlatColor
      Color: 235; 235; 235
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lio/global_map
      Queue Size: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Frontend Path
      Color: 255; 85; 0
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Value: /lio/path
      Queue Size: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Optimized Backend Path
      Color: 0; 220; 100
      Line Style: Lines
      Line Width: 0.08
      Topic:
        Value: /lio/backend/optimized_path
      Queue Size: 1
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 260
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Large Loop Overview
      Pitch: 1.15
      Target Frame: <Fixed Frame>
      Yaw: 0.785
