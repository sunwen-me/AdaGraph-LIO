<package format="3">
  <name>basic</name>
  <version>2.0.0</version>
  <description>The basic package</description>

  <maintainer email="lswang@mail.ecust.edu.cn">LS.Wang</maintainer>

  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libgflags-dev</depend>

  <!-- basic_core itself only requires Eigen; the package keeps the PCL/glog
       dependencies for the legacy basic compatibility facade. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
